{
  "name": "RgiQuarterlyReport",
  "type": "object",
  "properties": {
    "property_id": {
      "type": "string",
      "description": "Reference to Property"
    },
    "year": {
      "type": "integer",
      "description": "Report year"
    },
    "quarter": {
      "type": "integer",
      "description": "Quarter (1-4)",
      "minimum": 1,
      "maximum": 4
    },
    "revpar_index": {
      "type": "number",
      "description": "STR RevPAR Index (RGI) value for the quarter (e.g. 105.3 means 105.3% of competitive set)"
    },
    "revpar_index_change": {
      "type": "number",
      "description": "RGI % change YOY for the quarter (e.g. 2.5 = +2.5%)"
    },
    "revpar_index_prior": {
      "type": "number",
      "description": "RGI index value for same quarter prior year"
    }
  },
  "required": [
    "property_id",
    "year",
    "quarter"
  ]
}