{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "description": "User's email address (matches Base44 auth email)"
    },
    "full_name": {
      "type": "string",
      "description": "User's full name"
    },
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "property_user"
      ],
      "default": "property_user",
      "description": "User role \u2014 admin sees all, property_user sees assigned hotels only"
    },
    "assigned_properties": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of Property IDs this user can access"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this user has access to the app"
    },
    "invite_status": {
      "type": "string",
      "enum": [
        "not_invited",
        "invited",
        "active"
      ],
      "default": "not_invited",
      "description": "Invite lifecycle: not_invited \u2192 invited \u2192 active"
    },
    "invite_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when invite email was last sent"
    },
    "last_login": {
      "type": "string",
      "format": "date-time",
      "description": "Last login timestamp"
    }
  },
  "required": [
    "email",
    "role"
  ]
}