{
  "name": "Property",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Hotel name"
    },
    "str_id": {
      "type": "string",
      "description": "STR/Deployment ID for cross-app matching"
    },
    "parent_brand": {
      "type": "string",
      "description": "Parent brand (Marriott, Hilton, IHG, Hyatt, Choice, Independent)"
    },
    "sub_brand": {
      "type": "string",
      "description": "Sub-brand (e.g. Courtyard, DoubleTree)"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "rooms": {
      "type": "number",
      "description": "Number of rooms/keys"
    },
    "address": {
      "type": "string",
      "description": "Physical address"
    },
    "website": {
      "type": "string",
      "description": "Website URL"
    },
    "gm_name": {
      "type": "string",
      "description": "General Manager name"
    },
    "gss_metric": {
      "type": "string",
      "description": "GSS metric label (auto-derived from brand)"
    },
    "gss_target": {
      "type": "number",
      "description": "GSS improvement target"
    },
    "lead_type": {
      "type": "string",
      "description": "Lead type classification"
    },
    "department": {
      "type": "string",
      "description": "Department classification"
    },
    "corporate_operations": {
      "type": "string",
      "description": "Corporate Operations lead (per deployment roster)"
    },
    "corporate_finance": {
      "type": "string",
      "description": "Corporate Finance lead (per deployment roster)"
    },
    "corporate_hr": {
      "type": "string",
      "description": "Corporate HR lead (per deployment roster)"
    },
    "corporate_revenue": {
      "type": "string",
      "description": "Corporate Revenue lead (per deployment roster)"
    },
    "corporate_sales": {
      "type": "string",
      "description": "Corporate Sales lead (per deployment roster)"
    },
    "corporate_ecommerce": {
      "type": "string",
      "description": "Corporate E-Commerce lead (per deployment roster)"
    },
    "property_gm": {
      "type": "string",
      "description": "Property General Manager (per deployment roster)"
    },
    "property_dof": {
      "type": "string",
      "description": "Director of Finance (per deployment roster)"
    },
    "property_hrd": {
      "type": "string",
      "description": "Director of HR (per deployment roster)"
    },
    "property_dorm": {
      "type": "string",
      "description": "Director of Revenue (per deployment roster)"
    },
    "property_dosm": {
      "type": "string",
      "description": "Director of Sales & Marketing (per deployment roster)"
    },
    "property_doe": {
      "type": "string",
      "description": "Director of Engineering (per deployment roster)"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name"
  ]
}