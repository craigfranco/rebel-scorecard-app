{
  "name": "ScoreEntry",
  "type": "object",
  "properties": {
    "property_id": {
      "type": "string",
      "description": "Reference to Property"
    },
    "month": {
      "type": "integer",
      "description": "1-12"
    },
    "year": {
      "type": "integer"
    },
    "quarter": {
      "type": "integer",
      "description": "1-4"
    },
    "budgeted_gop_actual": {
      "type": "number",
      "description": "Actual GOP achieved ($)"
    },
    "budgeted_gop_target": {
      "type": "number",
      "description": "Budgeted GOP target ($)"
    },
    "budgeted_gop_prior": {
      "type": "number",
      "description": "Prior year GOP ($)"
    },
    "gop_margin_actual": {
      "type": "number",
      "description": "GOP margin % actual this period"
    },
    "gop_margin_prior": {
      "type": "number",
      "description": "GOP margin % prior year"
    },
    "gop_margin_budget": {
      "type": "number",
      "description": "GOP margin % budget/target this period"
    },
    "gop_margin_variance": {
      "type": "number",
      "description": "Variance between actual and budget GOP margin (actual - budget)"
    },
    "revpar_index_change": {
      "type": "number",
      "description": "STR RevPAR Index % change YOY (e.g. 2.5 = +2.5%)"
    },
    "revpar_index": {
      "type": "number",
      "description": "Actual RGI index value for current period (e.g. 105.3 means 105.3% of competitive set)"
    },
    "revpar_index_prior": {
      "type": "number",
      "description": "RGI index value for same period prior year"
    },
    "gss_actual": {
      "type": "number",
      "description": "GSS score this period"
    },
    "gss_prior": {
      "type": "number",
      "description": "GSS score prior year"
    },
    "forecast_kicker": {
      "type": "boolean",
      "description": "Forecast accuracy: actual vs primary forecast within acceptable range"
    },
    "forecast_result": {
      "type": "string",
      "enum": [
        "Hit",
        "Miss"
      ],
      "description": "Forecast accuracy result (Hit if actual >= forecast, Miss otherwise)"
    },
    "red_zone_kicker": {
      "type": "boolean",
      "description": "Exits and stays out of Red Zone"
    },
    "key_wins": {
      "type": "string"
    },
    "previous_results": {
      "type": "string"
    },
    "next_priorities": {
      "type": "string"
    },
    "prepared_by": {
      "type": "string"
    },
    "reviewed_by": {
      "type": "string"
    }
  },
  "required": [
    "property_id",
    "month",
    "year"
  ]
}