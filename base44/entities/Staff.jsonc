{
  "name": "Staff",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Staff member name"
    },
    "role": {
      "type": "string",
      "description": "Staff role (e.g. General Manager, Corporate Finance)"
    },
    "property_id": {
      "type": "string",
      "description": "Reference to Property"
    },
    "job_classification_id": {
      "type": "string",
      "description": "Reference to JobClassification"
    },
    "bonus_target_pct": {
      "type": "number",
      "description": "Quarterly bonus target as % of quarterly salary (e.g. 20 = 20%)"
    },
    "salary_q1": {
      "type": "number",
      "description": "Q1 salary"
    },
    "salary_q2": {
      "type": "number",
      "description": "Q2 salary"
    },
    "salary_q3": {
      "type": "number",
      "description": "Q3 salary"
    },
    "salary_q4": {
      "type": "number",
      "description": "Q4 salary"
    },
    "year": {
      "type": "integer",
      "description": "Year for this staff record"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "property_id",
    "job_classification_id",
    "year"
  ]
}