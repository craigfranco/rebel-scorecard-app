{
  "name": "GopQuarterlyReport",
  "type": "object",
  "properties": {
    "property_id": {
      "type": "string",
      "description": "Reference to Property"
    },
    "year": {
      "type": "integer",
      "description": "Report year"
    },
    "quarter": {
      "type": "integer",
      "description": "Quarter (1-4)",
      "minimum": 1,
      "maximum": 4
    },
    "gop_actual": {
      "type": "number",
      "description": "Actual GOP for the quarter ($)"
    },
    "gop_margin": {
      "type": "number",
      "description": "GOP margin % for the quarter (as reported)."
    }
  },
  "required": [
    "property_id",
    "year",
    "quarter"
  ]
}